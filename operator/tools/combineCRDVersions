# Populates helm-charts/gerrit-operator-crds/files/ with one subdirectory per
# CRD API version, each containing the single-version CRD YAMLs for that
# version.  Existing version directories are left untouched so that the full
# history of CRD versions accumulates across runs.  The static
# templates/crds.yaml discovers CRD kinds at render time via $.Files.Glob,
# so no template generation is required here.

SCRIPT_PATH="$(dirname "$(readlink -f "$0")")"

CHART_PATH="$SCRIPT_PATH/../../helm-charts/gerrit-operator-crds"
CHART_FILES_PATH="$CHART_PATH/files"

mkdir -p "$CHART_FILES_PATH"

# Copy every per-version single-version CRD YAML into files/<version>/, keeping
# the original filename so all versions of the same kind can coexist without
# encoding the version into the filename.
for dir in current deprecated; do
  CRD_DIR="$SCRIPT_PATH/../../crd/$dir"
  for f in "$CRD_DIR/"*.yml; do
    [ -f "$f" ] || continue
    version="$(yq e '.spec.versions[0].name' "$f")"
    mkdir -p "$CHART_FILES_PATH/$version"
    cp "$f" "$CHART_FILES_PATH/$version/$(basename "$f")"
  done
done
